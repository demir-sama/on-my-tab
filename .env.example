SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
PAY_TO=0xYourTestnetSellerAddress
KITE_NETWORK=testnet
FACILITATOR_URL=https://facilitator.pieverse.io/v2
# Display dollars -> test tokens (0.001: a $16 line settles 0.016 test USDC)
SETTLE_SCALE=0.001
ARC_RAIL=off
ARC_RPC_URL=
# Throwaway Arc TESTNET wallets only. Never a real wallet, never mainnet.
ARC_RELAYER_KEY=
ARC_BUYER_KEY=
# Live settlement on every run (needs ARC_RAIL=on, ARC_BUYER_KEY, PAY_TO)
LIVE_SETTLE=off
# Postgres (Neon) for the spend-cap ledger + SERV cache; scripts/schema.sql
DATABASE_URL=
# 32+ random chars each
RUN_TOKEN_SECRET=
VISITOR_SALT=
# Limits (defaults shown)
DAILY_SETTLE_CAP_USDC=2
DAILY_SETTLE_MAX_LINES=300
VISITOR_RUNS_PER_HOUR=3
VISITOR_LINES_PER_DAY=30
SERV_DAILY_LIMIT=40
SERV_VISITOR_PER_HOUR=4
SERV_CACHE_TTL_SEC=21600
